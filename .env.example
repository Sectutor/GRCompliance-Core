# GRCompliance environment template.
# Placeholders only. Do not put real secrets in this file.
# The installer generates a local .env with openssl rand and mode 600.

# --- Self-hosted containers ---
POSTGRES_USER=grc
POSTGRES_PASSWORD=replace-with-openssl-rand-hex
POSTGRES_DB=grcompliance
DATABASE_URL=postgres://grc:replace-with-openssl-rand-hex@db:5432/grcompliance?sslmode=disable
REDIS_PASSWORD=replace-with-openssl-rand-hex
JWT_SECRET=replace-with-openssl-rand-hex
ENCRYPTION_KEY=replace-with-openssl-rand-hex
ADMIN_EMAIL=admin@grcompliance.local
ADMIN_PASSWORD=replace-with-openssl-rand-hex
APP_URL=http://localhost:3001
APP_PORT=3001
GRC_VERSION=latest
AUTH_MODE=local

# Optional. Unset hides the preference notice. 1 shows a notice that stores a
# browser preference only. No advertising or analytics scripts load.
# GRC_COOKIE_CONSENT=1

# Used only with docker-compose.local-ports.yml (installer --bind-local).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# Set DATABASE_SSL=false for the bundled Postgres container.
DATABASE_SSL=false

# --- Optional hosted Supabase auth (leave unset when AUTH_MODE=local) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional server settings ---
PORT=3001
CORS_ORIGIN=http://localhost:3001
RATE_LIMITING_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
VITE_ENABLE_PREMIUM=false
VITE_APP_MODE=production

# --- Optional integrations. Values come from your secret store, not this file. ---
# OPENAI_API_KEY=
# SENDGRID_API_KEY=
# STRIPE_SECRET_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
